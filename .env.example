# ==========================================
# ASLENIX ATTENDANCE - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env or configure these variables in your environment/system/Docker

# Application
SPRING_APPLICATION_NAME=aslenix-attendance
PORT=8080

# Database Configuration
# Option 1: Provide full DB_URL
# DB_URL=jdbc:mysql://localhost:3306/aslenix_attendance?useSSL=false&serverTimezone=Asia/Kathmandu&allowPublicKeyRetrieval=true

# Option 2: Provide individual DB connection components
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aslenix_attendance
DB_USERNAME=root
DB_PASSWORD=Samip.....

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true

# Thymeleaf
THYMELEAF_CACHE=false

# File Upload Limits
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# ==========================================
# INITIAL SETUP & ADMIN PROVISIONING
# ==========================================
# When connecting to a fresh/empty database:
# Option 1 (Interactive): Leave AUTO_CREATE_ADMIN=false. Visiting http://localhost:8080/
# launches the Web Setup Wizard at /setup to create the Super Admin account interactively.
# Option 2 (Automated): Set AUTO_CREATE_ADMIN=true and define INITIAL_ADMIN_PASSWORD
# to automatically provision the admin on boot.
AUTO_CREATE_ADMIN=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@aslenix.local

IMAGEKIT_PUBLIC_KEY=public_ya787pz0qzjIbo0Wb7IYB+GHKww=

IMAGEKIT_PRIVATE_KEY=private_wgG7O/RG43VOFhabN1zTrT77ZjM=

IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/7gqvkziy4c