# ==========================================
# ASLENIX ATTENDANCE - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env or configure these variables in your environment/system/Docker

# Application
SPRING_APPLICATION_NAME=aslenix-attendance
PORT=8080

# Database Configuration
# Option 1: Provide full DB_URL
# DB_URL=jdbc:mysql://localhost:3306/aslenix_attendance?useSSL=false&serverTimezone=Asia/Kathmandu&allowPublicKeyRetrieval=true

# Option 2: Provide individual DB connection components
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aslenix_attendance
DB_USERNAME=root
DB_PASSWORD=Samip.....

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true

# Thymeleaf
THYMELEAF_CACHE=false

# File Upload Limits
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB
